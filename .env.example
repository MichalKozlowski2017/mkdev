# Treść strony: files | supabase | sanity
CONTENT_SOURCE=files

# Opcjonalnie — rewalidacja ISR (Sanity/Supabase webhook)
# REVALIDATE_SECRET=

# --- AI Studio (/studio) + ComfyUI ---
# Adres lokalnego ComfyUI (domyślnie port 8188)
COMFYUI_URL=http://127.0.0.1:8188

# Katalog modeli ComfyUI (checkpoints, loras, vae, …)
# Windows np.: C:\ComfyUI\models
# COMFYUI_MODELS_DIR=

# Katalog outputów ComfyUI
# Windows np.: C:\ComfyUI\output
# COMFYUI_OUTPUT_DIR=

# Opcjonalne hasło do /studio i /api/studio/* (puste = otwarte lokalnie)
# STUDIO_PASSWORD=
